<?xml version="1.0"?>
<sdf version="1.8">
  <!-- Keep physics, sensors, joints, and plugins identical to
       zju_diff_vehicle. Only the body material is changed so vehicle_1
       is visually identifiable in the GUI. -->
  <model name="zju_reference_vehicle">
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>0.4833333333</ixx>
          <iyy>1.1333333333</iyy>
          <izz>1.4833333333</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box><size>0.8 0.5 0.2</size></box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box><size>0.8 0.5 0.2</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.25 0.03 1</ambient>
          <diffuse>1.0 0.38 0.04 1</diffuse>
        </material>
      </visual>
      <visual name="upper_deck">
        <pose>0 0 0.18 0 0 0</pose>
        <geometry><box><size>0.64 0.42 0.08</size></box></geometry>
        <material><ambient>0.16 0.05 0.015 1</ambient><diffuse>0.30 0.10 0.02 1</diffuse></material>
      </visual>
      <visual name="sensor_mast">
        <pose>0.18 0 0.43 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.42</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.08 0.10 1</diffuse></material>
      </visual>
      <visual name="lidar_head">
        <pose>0.18 0 0.66 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.01 0.01 0.015 1</ambient><diffuse>0.02 0.025 0.035 1</diffuse></material>
      </visual>
      <visual name="camera_housing">
        <pose>0.35 0 0.30 0 0 0</pose>
        <geometry><box><size>0.18 0.24 0.13</size></box></geometry>
        <material><ambient>0.16 0.05 0.015 1</ambient><diffuse>0.35 0.11 0.02 1</diffuse></material>
      </visual>
      <visual name="front_bumper">
        <pose>0.42 0 0.08 0 0 0</pose>
        <geometry><box><size>0.08 0.52 0.10</size></box></geometry>
        <material><ambient>0.95 0.70 0.04 1</ambient><diffuse>1.0 0.86 0.10 1</diffuse></material>
      </visual>
      <visual name="left_id_strip">
        <pose>0 0.255 0.04 0 0 0</pose>
        <geometry><box><size>0.52 0.015 0.08</size></box></geometry>
        <material><ambient>0.98 0.56 0.03 1</ambient><diffuse>1.0 0.75 0.06 1</diffuse></material>
      </visual>
      <visual name="right_id_strip">
        <pose>0 -0.255 0.04 0 0 0</pose>
        <geometry><box><size>0.52 0.015 0.08</size></box></geometry>
        <material><ambient>0.98 0.56 0.03 1</ambient><diffuse>1.0 0.75 0.06 1</diffuse></material>
      </visual>
      <visual name="left_rear_wheel">
        <pose>-0.27 0.30 -0.10 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.025 0.025 0.03 1</ambient><diffuse>0.04 0.045 0.055 1</diffuse></material>
      </visual>
      <visual name="right_rear_wheel">
        <pose>-0.27 -0.30 -0.10 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.025 0.025 0.03 1</ambient><diffuse>0.04 0.045 0.055 1</diffuse></material>
      </visual>
      <visual name="left_side_panel">
        <pose>0 0.265 0.13 0 0 0</pose>
        <geometry><box><size>0.62 0.025 0.12</size></box></geometry>
        <material><ambient>0.24 0.07 0.02 1</ambient><diffuse>0.45 0.14 0.03 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <visual name="right_side_panel">
        <pose>0 -0.265 0.13 0 0 0</pose>
        <geometry><box><size>0.62 0.025 0.12</size></box></geometry>
        <material><ambient>0.24 0.07 0.02 1</ambient><diffuse>0.45 0.14 0.03 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <visual name="front_light_left">
        <pose>0.405 0.14 0.17 0 0 0</pose>
        <geometry><box><size>0.025 0.07 0.055</size></box></geometry>
        <material><ambient>0.8 0.9 1.0 1</ambient><diffuse>0.95 1.0 1.0 1</diffuse><emissive>0.75 0.85 1.0 1</emissive></material>
      </visual>
      <visual name="front_light_right">
        <pose>0.405 -0.14 0.17 0 0 0</pose>
        <geometry><box><size>0.025 0.07 0.055</size></box></geometry>
        <material><ambient>0.8 0.9 1.0 1</ambient><diffuse>0.95 1.0 1.0 1</diffuse><emissive>0.75 0.85 1.0 1</emissive></material>
      </visual>
      <visual name="rear_battery_box">
        <pose>-0.30 0 0.20 0 0 0</pose>
        <geometry><box><size>0.24 0.34 0.12</size></box></geometry>
        <material><ambient>0.10 0.04 0.015 1</ambient><diffuse>0.20 0.07 0.02 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>

      <!-- The first version assumes the IMU and UWB reference point coincide
           with base_link and are axis-aligned with vehicle FLU. -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <ignition_frame_id>imu_link</ignition_frame_id>
      </sensor>

      <!-- Optional development sensors. They stay idle until their Gazebo
           topics have subscribers; the production localization nodes do not
           subscribe to either raw stream. -->
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0.20 0 0.20 0 0 0</pose>
        <always_on>false</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>40.0</max>
            <resolution>0.02</resolution>
          </range>
        </lidar>
      </sensor>

      <sensor name="front_camera" type="camera">
        <pose>0.41 0 0.10 0 0 0</pose>
        <always_on>false</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047197551196598</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0.10 0.30 -0.10 1.5707963267948966 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.0061583333</ixx>
          <iyy>0.0061583333</iyy>
          <izz>0.01125</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.08</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0.10 -0.30 -0.10 1.5707963267948966 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.0061583333</ixx>
          <iyy>0.0061583333</iyy>
          <izz>0.01125</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.08</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="caster">
      <pose>-0.30 0 -0.17 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00128</ixx><iyy>0.00128</iyy><izz>0.00128</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>
    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.60</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>0.30</max_linear_acceleration>
      <min_linear_acceleration>-0.30</min_linear_acceleration>
      <max_angular_acceleration>0.50</max_angular_acceleration>
      <min_angular_acceleration>-0.50</min_angular_acceleration>
    </plugin>
    <plugin filename="libignition-gazebo-pose-publisher-system.so"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
