<?xml version="1.0"?>
<sdf version="1.8">
  <model name="truth_camera">
    <static>true</static>
    <link name="camera_mount">
      <visual name="mount"><geometry><cylinder><radius>0.12</radius><length>0.30</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      <sensor name="overhead_camera" type="camera">
        <!-- +X optical axis rotated downward to -Z. -->
        <pose>0 0 0 0 1.57079632679 0</pose>
        <always_on>false</always_on>
        <update_rate>120</update_rate>
        <topic>/surface_rov/camera/overhead/image</topic>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.04719755</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>30.0</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
