<?xml version="1.0"?>
<sdf version="1.8">
  <model name="zju_warehouse_frame">
    <static>true</static>
    <link name="frame">
      <!-- Steel columns and roof beams.  The model is deliberately local and
           mesh-free so it works offline on the development machine. -->
