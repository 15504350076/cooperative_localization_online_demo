<?xml version="1.0"?>
<sdf version="1.8">
  <!-- World x/y/z are interpreted as ENU east/north/up. Positive yaw is
       counter-clockwise from east. Model x/y/z are vehicle FLU. -->
  <world name="zju_coop_gazebo">
    <physics name="one_khz" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>0 0 0</magnetic_field>

    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <!-- Reference vehicle uses the orange visual variant; its dynamics,
           IMU, and pose-publisher contract are unchanged. -->
      <uri>model://zju_reference_vehicle</uri>
      <name>vehicle_1</name>
      <pose>0 0 0.25 0 0 0</pose>
    </include>
    <include>
      <uri>model://zju_diff_vehicle</uri>
      <name>vehicle_2</name>
      <pose>4 0 0.25 0 0 0</pose>
    </include>
    <include>
      <uri>model://zju_diff_vehicle</uri>
      <name>vehicle_3</name>
      <pose>0 3 0.25 0 0 1.5707963267948966</pose>
    </include>
  </world>
</sdf>
