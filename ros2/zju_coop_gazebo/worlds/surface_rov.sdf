<?xml version="1.0"?>
<sdf version="1.8">
  <world name="surface_rov">
    <!-- 200 Hz is sufficient for the 100 Hz IMU while keeping this small
         Fortress scene close to real time on a laptop. -->
    <physics name="two_hundred_hz" type="ode"><max_step_size>0.005</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>0 0 0</magnetic_field>
    <scene><grid>false</grid></scene>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Fortress supports graded buoyancy: water below z=0 and air above it. -->
    <plugin filename="libignition-gazebo-buoyancy-system.so" name="ignition::gazebo::systems::Buoyancy">
      <graded_buoyancy><default_density>1000</default_density><density_change><above_depth>0</above_depth><density>1</density></density_change></graded_buoyancy>
    </plugin>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 12 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 0.2 -0.9</direction></light>
    <model name="water_surface"><static>true</static>
      <link name="link">
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry><material><ambient>0.02 0.16 0.24 0.85</ambient><diffuse>0.03 0.24 0.38 0.85</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
      </link>
    </model>
    <model name="pool_floor"><static>true</static>
      <pose>0 0 -4 0 0 0</pose><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry><material><ambient>0.08 0.12 0.14 1</ambient><diffuse>0.08 0.12 0.14 1</diffuse></material></visual></link>
    </model>
    <model name="pool_walls"><static>true</static><link name="link">
      <collision name="west"><pose>-30 0 -2 0 0 0</pose><geometry><box><size>0.2 60 4</size></box></geometry></collision><collision name="east"><pose>30 0 -2 0 0 0</pose><geometry><box><size>0.2 60 4</size></box></geometry></collision><collision name="south"><pose>0 -30 -2 0 0 0</pose><geometry><box><size>60 0.2 4</size></box></geometry></collision><collision name="north"><pose>0 30 -2 0 0 0</pose><geometry><box><size>60 0.2 4</size></box></geometry></collision>
    </link></model>
    <include><uri>model://zju_surface_rov</uri><name>surface_rov</name><pose>0 0 -0.10 0 0 0</pose></include>
    <include><uri>model://zju_truth_camera</uri><name>truth_camera</name><pose>0 0 8 0 0 0</pose></include>
  </world>
</sdf>
